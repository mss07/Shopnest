<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Console Appender with Correlation ID -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level [%X{correlationId:-NO_ID}] [%X{testScenario:-NO_SCENARIO}] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- File Appender for Test Logs with Correlation ID -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>target/logs/api-tests.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>target/logs/api-tests.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <timeBasedFileNamingAndTriggeringPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedFNATP">
                <maxFileSize>10MB</maxFileSize>
            </timeBasedFileNamingAndTriggeringPolicy>
            <maxHistory>30</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level [%X{correlationId:-NO_ID}] [%X{testScenario:-NO_SCENARIO}] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- HTTP Request/Response Appender with Enhanced Context -->
    <appender name="HTTP_LOG" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>target/logs/http-interactions.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>target/logs/http-interactions.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <timeBasedFileNamingAndTriggeringPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedFNATP">
                <maxFileSize>20MB</maxFileSize>
            </timeBasedFileNamingAndTriggeringPolicy>
            <maxHistory>30</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level [%X{correlationId:-NO_ID}] [%X{testScenario:-NO_SCENARIO}] [%X{requestType:-NO_TYPE}] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Performance Metrics Appender -->
    <appender name="METRICS_LOG" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>target/logs/performance-metrics.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>target/logs/performance-metrics.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <timeBasedFileNamingAndTriggeringPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedFNATP">
                <maxFileSize>10MB</maxFileSize>
            </timeBasedFileNamingAndTriggeringPolicy>
            <maxHistory>30</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level [%X{correlationId:-NO_ID}] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Error Log Appender -->
    <appender name="ERROR_LOG" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>target/logs/api-errors.log</file>
        <filter class="ch.qos.logback.classic.filter.LevelFilter">
            <level>ERROR</level>
            <onMatch>ACCEPT</onMatch>
            <onMismatch>DENY</onMismatch>
        </filter>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>target/logs/api-errors.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <timeBasedFileNamingAndTriggeringPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedFNATP">
                <maxFileSize>10MB</maxFileSize>
            </timeBasedFileNamingAndTriggeringPolicy>
            <maxHistory>30</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level [%X{correlationId:-NO_ID}] [%X{testScenario:-NO_SCENARIO}] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Logger for HTTP interactions -->
    <logger name="HTTP_INTERACTIONS" level="INFO" additivity="false">
        <appender-ref ref="HTTP_LOG"/>
        <appender-ref ref="CONSOLE"/>
    </logger>

    <!-- Logger for API errors -->
    <logger name="API_ERRORS" level="ERROR" additivity="false">
        <appender-ref ref="ERROR_LOG"/>
        <appender-ref ref="CONSOLE"/>
    </logger>

    <!-- Logger for performance metrics -->
    <logger name="com.ecommerce.api.utils.PerformanceMetrics" level="INFO" additivity="false">
        <appender-ref ref="METRICS_LOG"/>
        <appender-ref ref="CONSOLE"/>
    </logger>

    <!-- Logger for API client -->
    <logger name="com.ecommerce.api.client" level="DEBUG" additivity="false">
        <appender-ref ref="HTTP_LOG"/>
        <appender-ref ref="CONSOLE"/>
    </logger>

    <!-- Logger for step definitions -->
    <logger name="com.ecommerce.api.stepdefinitions" level="DEBUG" additivity="false">
        <appender-ref ref="FILE"/>
        <appender-ref ref="CONSOLE"/>
    </logger>

    <!-- Logger for REST Assured (reduced verbosity) -->
    <logger name="io.restassured" level="WARN" additivity="false">
        <appender-ref ref="HTTP_LOG"/>
    </logger>

    <!-- Logger for Cucumber -->
    <logger name="io.cucumber" level="INFO" additivity="false">
        <appender-ref ref="FILE"/>
        <appender-ref ref="CONSOLE"/>
    </logger>

    <!-- Root Logger -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
        <appender-ref ref="ERROR_LOG"/>
    </root>
</configuration>